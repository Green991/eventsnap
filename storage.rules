rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotos de Eventos
    // Ruta: event_photos/{eventId}/{fileName}
    match /event_photos/{eventId}/{fileName} {
      // Lectura pública (para galerías)
      allow read: if true;
      
      // Escritura pública (invitados sin login) con validación reforzada.
      // Imágenes: hasta 25MB
      // Vídeos cortos: hasta 12MB
      allow create: if
        request.resource.size > 0 &&
        (
          (
            request.resource.contentType.matches('image/(jpeg|jpg|png|webp)(;.*)?') &&
            request.resource.size < 25 * 1024 * 1024
          ) || (
            request.resource.contentType.matches('video/(mp4|webm|quicktime)(;.*)?') &&
            request.resource.size < 12 * 1024 * 1024
          )
        );
      
      // Borrado solo para usuarios autenticados (Anfitriones)
      allow delete: if request.auth != null;
    }
  }
}
